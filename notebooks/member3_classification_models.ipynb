   "source": [
    "# Member 3 — Classification Preprocessing, Models, Evaluation\n",
    "\n",
    "Dataset: `data/raw/adult/adult_train.csv` / `adult_test.csv` (UCI Adult / Census Income).\n",
    "Target: `income` (`<=50K` / `>50K`), binary classification.\n",
    "Scope: preprocessing,5 classifiers (Logistic Regression, KNN, Gaussian Naive Bayes, Decision Tree,\n",
    "SVC), evaluation (accuracy, weighted F1,\n",
    "macro F1, confusion matrix per algorithm)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
