   "source": [
    "## 2. Clean missing values\n",
    "\n",
    "`'?'` marks missing entries in `workclass`, `occupation`, `native-country`. Rows with any\n",
    "missing value are dropped (small fraction of the data) rather than imputed, to keep the\n",
    "classification signal clean."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ba8db039",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-20T12:35:57.411593Z",
     "iopub.status.busy": "2026-09-20T12:35:57.411493Z",
     "iopub.status.idle": "2026-09-20T12:35:57.454540Z",
     "shell.execute_reply": "2026-09-20T12:35:57.454176Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "train missing per column:\n",
      "workclass         1836\n",
      "occupation        1843\n",
      "native-country     583\n",
      "dtype: int64\n",
      "\n",
      "after dropna -> train: (30162, 15) test: (15060, 15)\n"
     ]
    }
   ],
   "source": [
    "for df in (train_df, test_df):\n",
    "    df.replace('?', np.nan, inplace=True)\n",
    "\n",
    "print('train missing per column:')\n",
    "print(train_df.isna().sum()[train_df.isna().sum() > 0])\n",
    "\n",
    "train_df.dropna(inplace=True)\n",
    "test_df.dropna(inplace=True)\n",
    "train_df.reset_index(drop=True, inplace=True)\n",
    "test_df.reset_index(drop=True, inplace=True)\n",
    "\n",
    "print('\\nafter dropna -> train:', train_df.shape, 'test:', test_df.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "204d13e0",
   "metadata": {},
   "source": [
    "## 2b. Whitespace + target normalization\n",
    "\n",
    "Defensive cleanup even though the raw `.data`/`.test` files were already converted with\n",
    "`skipinitialspace=True` and a trailing-period strip on `income` (see `convert_adult.py`):\n",
    "strip stray whitespace from every categorical column, and normalize `income` in case\n",
    "`>50K.` / `<=50K.` (the known test-split quirk) ever creeps back in."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fff38e2b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-20T12:35:57.455834Z",
     "iopub.status.busy": "2026-09-20T12:35:57.455750Z",
     "iopub.status.idle": "2026-09-20T12:35:57.496056Z",
     "shell.execute_reply": "2026-09-20T12:35:57.495630Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "train income values: ['<=50K' '>50K']\n",
      "test income values: ['<=50K' '>50K']\n"
     ]
    }
   ],
   "source": [
    "for df in (train_df, test_df):\n",
    "    obj_cols = df.select_dtypes(include='object').columns\n",
    "    for col in obj_cols:\n",
    "        df[col] = df[col].str.strip()\n",
    "    df['income'] = df['income'].str.rstrip('.')\n",
    "\n",
    "print('train income values:', train_df['income'].unique())\n",
    "print('test income values:', test_df['income'].unique())"
   ]
  },
  {
