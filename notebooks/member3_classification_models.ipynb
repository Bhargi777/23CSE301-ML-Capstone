   ],
   "source": [
    "n_dupes = train_df.duplicated().sum()\n",
    "train_df = train_df.drop_duplicates().reset_index(drop=True)\n",
    "print(f'dropped {n_dupes} duplicate train rows -> train shape:', train_df.shape)"
