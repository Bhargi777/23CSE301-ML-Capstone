    "TRAIN_PATH = Path('../data/raw/adult/adult_train.csv')\n",
    "TEST_PATH = Path('../data/raw/adult/adult_test.csv')\n",
    "\n",
    "train_df = pd.read_csv(TRAIN_PATH)\n",
    "test_df = pd.read_csv(TEST_PATH)\n",
    "\n",
